{
  "homepage": "https://IAUCourseExp.github.io/iau-experiences",
  "name": "iaucourseexptg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "nlp:build": "python tools/nlp_pipeline.py --data src/data.json --out src/derived/atlas.json --summary audit-artifacts/phase-4/pipeline-summary.json",
    "release-preflight": "node tools/release-preflight.mjs",
    "release-ship": "node tools/release-ship.mjs",
    "deploy-all": "node tools/write-release-time.mjs && npm run release-preflight && npm run release-ship"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4",
    "vitest": "^5.0.5"
  },
  "description": "IAU Experiences — frontend for the student experience directory of Islamic Azad University of Shiraz (React + Vite + Tailwind, deployed to GitHub Pages under /iau-experiences/).",
